data: {"result":{"content":[{"type":"text","text":"### Serving Static Files with express.static\n\nSource: https://context7.com/expressjs/express/llms.txt\n\nServe static files from one or more directories using express.static middleware. Supports virtual path prefixes and detailed configuration for caching and headers.\n\n```javascript\nconst express = require('express')\nconst path = require('path')\n\nconst app = express()\n\n// Serve static files from 'public' directory\n// GET /style.css -> ./public/style.css\n// GET /js/app.js -> ./public/js/app.js\napp.use(express.static(path.join(__dirname, 'public')))\n\n// Serve with virtual path prefix\n// GET /static/style.css -> ./public/style.css\napp.use('/static', express.static(path.join(__dirname, 'public')))\n\n// Multiple static directories (checked in order)\napp.use(express.static(path.join(__dirname, 'public')))\napp.use(express.static(path.join(__dirname, 'uploads')))\n\n// Static files with options\napp.use('/assets', express.static(path.join(__dirname, 'assets'), {\n  maxAge: '1d',           // Cache for 1 day\n  etag: true,             // Enable ETag\n  lastModified: true,     // Enable Last-Modified\n  index: 'index.html',    // Default index file\n  dotfiles: 'ignore',     // How to handle dotfiles: 'allow', 'deny', 'ignore'\n  redirect: true,         // Redirect to trailing / for directories\n  immutable: true,        // Add immutable directive to Cache-Control\n  extensions: ['html', 'htm'], // Try these extensions\n  fallthrough: true       // Pass to next middleware if file not found\n}))\n\n// Serve files only for specific file types\napp.use('/images', express.static(path.join(__dirname, 'images'), {\n  setHeaders: (res, filePath) => {\n    if (filePath.endsWith('.jpg') || filePath.endsWith('.png')) {\n      res.set('Cache-Control', 'public, max-age=31536000')\n    }\n  }\n}))\n\napp.listen(3000)\nconsole.log('Static files served from /public')\n\n// curl http://localhost:3000/style.css\n// curl http://localhost:3000/static/js/app.js\n// curl http://localhost:3000/images/logo.png\n```\n\n--------------------------------\n\n### Custom Error Handling in Express.js\n\nSource: https://context7.com/expressjs/express/llms.txt\n\nImplement custom error classes and middleware to handle errors gracefully. Ensure the general error handler is defined last with four parameters.\n\n```javascript\nconst express = require('express')\nconst app = express()\n\n// Custom error class\nclass AppError extends Error {\n  constructor(message, status) {\n    super(message)\n    this.status = status\n  }\n}\n\n// Routes that might throw errors\napp.get('/users/:id', async (req, res, next) => {\n  try {\n    const id = parseInt(req.params.id)\n    if (isNaN(id)) {\n      throw new AppError('Invalid user ID', 400)\n    }\n    if (id === 0) {\n      throw new AppError('User not found', 404)\n    }\n    res.json({ id, name: `User ${id}` })\n  } catch (err) {\n    next(err) // Pass error to error handler\n  }\n})\n\n// Async error handling (Express 5+ handles async automatically)\napp.get('/async-error', async (req, res) => {\n  // In Express 5, rejected promises are automatically caught\n  throw new Error('Async error occurred')\n})\n\n// Trigger 404 by not responding\napp.get('/not-found', (req, res, next) => {\n  next() // No response sent, falls through to 404 handler\n})\n\n// 404 handler (must be after all routes)\napp.use((req, res, next) => {\n  res.status(404)\n  res.format({\n    html: () => res.send('<h1>404 - Page Not Found</h1>'),\n    json: () => res.json({ error: 'Not Found', path: req.path }),\n    default: () => res.type('txt').send('Not Found')\n  })\n})\n\n// General error handler (must be last, must have 4 parameters)\napp.use((err, req, res, next) => {\n  const status = err.status || 500\n  const message = err.message || 'Internal Server Error'\n\n  // Log error\n  console.error(`Error ${status}: ${message}`)\n  if (status >= 500) {\n    console.error(err.stack)\n  }\n\n  res.status(status)\n  res.format({\n    html: () => {\n      res.send(\n        `\n        <h1>Error ${status}</h1>\n        <p>${message}</p>\n        ${process.env.NODE_ENV !== 'production' ? `<pre>${err.stack}</pre>` : ''}\n      `\n      )\n    },\n    json: () => {\n      const response = { error: message }\n      if (process.env.NODE_ENV !== 'production') {\n        response.stack = err.stack\n      }\n      res.json(response)\n    },\n    default: () => res.type('txt').send(message)\n  })\n})\n\napp.listen(3000)\n\n// curl http://localhost:3000/users/abc\n// curl http://localhost:3000/users/0\n// curl http://localhost:3000/missing-page\n// curl http://localhost:3000/async-error\n```\n\n--------------------------------\n\n### Route Parameters and Param Middleware\n\nSource: https://context7.com/expressjs/express/llms.txt\n\nUse app.param to trigger logic for specific route parameters before the route handler executes. This example demonstrates handling dynamic IDs, nested resources, wildcards, and optional parameters.\n\n```javascript\nconst express = require('express')\nconst app = express()\n\n// Placeholder database\nconst users = {\n  '1': { id: 1, name: 'John', role: 'admin' },\n  '2': { id: 2, name: 'Jane', role: 'user' }\n}\n\nconst posts = {\n  '1': { id: 1, title: 'First Post', userId: 1 },\n  '2': { id: 2, title: 'Second Post', userId: 2 }\n}\n\n// Param middleware - runs before routes with :userId\napp.param('userId', (req, res, next, id) => {\n  const user = users[id]\n  if (!user) {\n    return res.status(404).json({ error: 'User not found' })\n  }\n  req.user = user\n  next()\n})\n\napp.param('postId', (req, res, next, id) => {\n  const post = posts[id]\n  if (!post) {\n    return res.status(404).json({ error: 'Post not found' })\n  }\n  req.post = post\n  next()\n})\n\n// Routes using params\napp.get('/users/:userId', (req, res) => {\n  res.json(req.user)\n})\n\napp.get('/users/:userId/posts', (req, res) => {\n  const userPosts = Object.values(posts).filter(p => p.userId === req.user.id)\n  res.json(userPosts)\n})\n\napp.get('/posts/:postId', (req, res) => {\n  res.json(req.post)\n})\n\n// Nested params\napp.get('/users/:userId/posts/:postId', (req, res) => {\n  if (req.post.userId !== req.user.id) {\n    return res.status(404).json({ error: 'Post not found for this user' })\n  }\n  res.json({ user: req.user, post: req.post })\n})\n\n// Wildcard parameters\napp.get('/files/*file', (req, res) => {\n  // req.params.file is an array: ['path', 'to', 'file.txt']\n  const filePath = req.params.file.join('/')\n  res.json({ path: filePath })\n})\n\n// Optional parameters (use regex or separate routes)\napp.get('/items/:id(\\\\d+)?', (req, res) => {\n  if (req.params.id) {\n    res.json({ item: req.params.id })\n  } else {\n    res.json({ items: 'all' })\n  }\n})\n\napp.listen(3000)\n\n// curl http://localhost:3000/users/1\n// curl http://localhost:3000/users/1/posts\n// curl http://localhost:3000/users/1/posts/1\n// curl http://localhost:3000/files/documents/reports/2024/annual.pdf\n```\n\n--------------------------------\n\n### Wildcard route `/*splat` named parameter replaces `*`\n\nSource: https://github.com/expressjs/express/blob/master/test/app.all.js\n\nThe `/*splat` pattern with path-to-regexp v3 (v8) named wildcard parameter replaces the old `*` wildcard. The matched value is available as `req.params.splat`. The old special `*` path segment behavior was removed in router@2.0.0-beta.1 with the upgrade to path-to-regexp@3.2.0.\n\n```javascript\napp.all('/*splat', function(req, res, next){\n  if (n++) return done(new Error('DELETE called several times'));\n  next();\n});\n```\n\n### Error Handling > Async Error Handling\n\nSource: https://context7.com/expressjs/express/llms.txt\n\nExpress 5+ automatically catches rejected promises from async route handlers, eliminating the need for manual try-catch blocks in async functions. This simplifies error handling for asynchronous operations by automatically passing unhandled promise rejections to error middleware."}]},"jsonrpc":"2.0","id":6}

